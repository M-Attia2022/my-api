# Environment Variables — YallaKoshari API
# انسخ الملف ده واعمله اسم .env وحط فيه القيم الصح

# ===== Database (Neon PostgreSQL) =====
# هتلاقيه في dashboard بتاع neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ===== JWT Secrets =====
# استخدم strings عشوائية طويلة (مش نفس القيم دي!)
JWT_SECRET="change_this_to_a_very_long_random_secret_string_min_32_chars"
JWT_REFRESH_SECRET="change_this_to_another_different_long_random_secret_string"

# ===== App =====
NODE_ENV="development"
PORT=3000

# ===== CORS (اختياري) =====
# حط URLs التطبيق بتاعك مفصولة بفواصل
# ALLOWED_ORIGINS="https://myapp.com,https://www.myapp.com"
